{
  "$schema": "https://raw.githubusercontent.com/anomalyco/strobe/main/schema/strobe.v1.json",
  "build": {
    "command": "cargo build --locked --release --bin voinc",
    "output": {
      "windows": "{cache}/cargo-target/release/voinc.exe",
      "macos": "{cache}/cargo-target/release/voinc",
      "linux": "{cache}/cargo-target/release/voinc"
    },
    "env": {
      "CARGO_TARGET_DIR": "{cache}/cargo-target",
      "CARGO_PROFILE_RELEASE_DEBUG": "line-tables-only",
      "CARGO_PROFILE_RELEASE_STRIP": "false",
      "CARGO_PROFILE_RELEASE_INCREMENTAL": "false",
      "TRANSCRIBE_CMAKE_ARGS": "-DGGML_NATIVE=OFF"
    },
    "windows": {
      "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
    }
  },
  "apps": {
    "voinc": {
      "kind": "native",
      "exe": {
        "windows": "target/release/voinc.exe",
        "macos": "/Applications/Voinc.app/Contents/MacOS/voinc",
        "linux": "~/.local/share/voinc/current/voinc"
      },
      "args": ["app"],
      "env": {
        "VOINC_APPLICATION_SUPPORT_DIR": "{home}/voinc-data",
        "VOINC_DISABLE_UPDATES": "1",
        "HF_HUB_CACHE": "{home}/.cache/huggingface/hub"
      },
      "unset": ["VOINC_*", "WGPU_*", "RUNE_*", "HF_HOME", "RUST_LOG"],
      "moved": ["~/Library/Application Support/voinc"],
      "files": {
        "voinc-data/onboarding-complete": "",
        "voinc-data/settings.json": {
          "enable_on_launch": false,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "voinc-identity"]
        }
      },
      "guard": [
        { "os": "windows", "file": "%APPDATA%/voinc/local-api.json", "pid": "pid" },
        { "os": "windows", "file": "%APPDATA%/voinc/settings.json" },
        { "os": "macos", "file": "~/Library/Application Support/voinc/local-api.json", "pid": "pid" },
        { "os": "macos", "file": "~/Library/Application Support/voinc/settings.json" },
        { "os": "linux", "file": "~/.local/share/voinc/local-api.json", "pid": "pid" },
        { "os": "linux", "file": "~/.local/share/voinc/settings.json" }
      ]
    },
    "voinc-listening": {
      "extends": "voinc",
      "files": {
        "voinc-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "voinc-identity"]
        }
      }
    },
    "voinc-listening-warm": {
      "extends": "voinc",
      "files": {
        "voinc-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "voinc-identity"]
        }
      }
    },
    "voinc-dictation": {
      "extends": "voinc",
      "env": { "VOINC_AUDIO_FIXTURE": "{home}/speech.wav" },
      "files": {
        "voinc-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "voinc-identity"]
        }
      }
    },
    "voinc-dictation-released": {
      "extends": "voinc-dictation",
      "files": {
        "voinc-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "voinc-identity"]
        }
      }
    }
  },
  "benches": ["perf/**/*.bench.ts"],
  "metrics": { "equivalence": "2%" }
}
