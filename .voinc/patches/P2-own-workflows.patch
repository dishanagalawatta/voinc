-name: Release
-
-# Builds, signs, and publishes Voinc for macOS, Windows, and Linux from one
-# exact commit to the Anomaly release service (docs/releasing.md,
-# docs/plans/release-service.md), split the way OpenCode's release is:
-#
-# - build jobs (Build desktop, build-macos, Windows installers, the AUR and
-#   Homebrew staging) run repository code: cargo, build.rs, makepkg,
-#   brew. They have no environment, no secrets, and no id-token, and they
-#   produce unsigned files.
-# - sign and publish jobs run in the release environment. They check out only
-#   .github/release/ and run only those scripts and SHA-pinned actions, on
-#   artifacts they treat as data: they never build, install dependencies, or
-#   execute repository code or the artifacts. Their credentials come from AWS
-#   Secrets Manager through GitHub OIDC, not repository secrets, and are
-#   step-scoped: the AWS session is only a step output of
-#   configure-aws-credentials, passed to the one step that reads secrets
-#   (.github/release/with-secrets.sh), so neither it nor a secret is ever in
-#   the job's environment or $GITHUB_ENV.
-# - every artifact carries a SHA256SUMS whose digest the job that made it
-#   reports as an output; every job that downloads it checks that digest
-#   (.github/release/verify-artifacts.sh), so nothing swapped in between
-#   jobs is signed or published.
-#
-# This file and .github/release/ are the security boundary for releases, and
-# a ruleset lets only Dax change .github/ (docs/releasing.md).
-#
-# There is one environment, release, like OpenCode's: no approval, deployment
-# policy dev and production. The service authorizes the publish jobs by their
-# OIDC token: dishanagalawatta/voinc, this file, environment release, the dev channel
-# from dev and stable from production (anomalyco/release registry/voinc.json).
-# Voinc never uses the service's dev stage.
-#
-# Channels (.github/release/plan.sh):
-# - dev: every push to dev (except docs/site/Markdown-only) publishes
-#   0.0.0-dev-<run number> on the dev channel, as OpenCode numbers dev builds;
-#   a running release finishes and only the newest push waits behind it
-#   (the ones between are skipped). Only signed platforms are
-#   published. Versions are display text: installs follow the channel's
-#   current release and never compare versions.
-# - check: a dispatch from dev builds, signs, and verifies the same and
-#   publishes nothing; its last job pushes and deletes a throwaway
-#   v0.0.0-test-<run> tag to prove it can tag.
-# - stable: a dispatch from production publishes the crate version with every
-#   platform signed, the AUR, and Homebrew. Tags trigger nothing: only after
-#   everything published does the last job tag v<version> on the released
-#   commit and create the GitHub release, so a failed run leaves no tag. Deploy the production site afterwards with Deploy.
-#
-# A run always releases the commit it runs on (github.sha): there is no ref
-# input, every job checks out github.sha, and plan.sh fails unless the commit
-# it checked out is github.sha. So the scripts the release-environment jobs
-# run are always this workflow's own commit of dev or production.
-on:
-  workflow_dispatch:
-    inputs:
-      channel:
-        description: check (build, sign, and verify; publish nothing), dev (the dev channel; run from dev), or stable (public)
-        type: choice
-        options: [check, dev, stable]
-        default: check
-  push:
-    branches: [dev]
-    # Docs and the site alone cut no dev build.
-    paths-ignore: ["docs/**", "site/**", "**/*.md"]
-
-permissions:
-  contents: read
-
-concurrency:
-  group: release-${{ github.event_name == 'workflow_dispatch' && inputs.channel || 'dev' }}
-  # Releases never cancel each other: the running one finishes, and of the
-  # pushes that land meanwhile only the newest waits (GitHub replaces an
-  # older pending run in the group), so a busy dev branch still publishes.
-  cancel-in-progress: false
-
-defaults:
-  run:
-    shell: bash
-
-env:
-  VOINC_TEAM_ID: 5NZ4Q7NXJ4
-
-jobs:
-  plan:
-    runs-on: ubuntu-24.04
-    outputs:
-      version: ${{ steps.plan.outputs.version }}
-      channel: ${{ steps.plan.outputs.channel }}
-      service: ${{ steps.plan.outputs.service }}
-      tag: ${{ steps.plan.outputs.tag }}
-      notes-url: ${{ steps.plan.outputs.notes-url }}
-      release-channel: ${{ steps.plan.outputs.release-channel }}
-      release-version: ${{ steps.plan.outputs.release-version }}
-    steps:
-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
-        with:
-          ref: ${{ github.sha }}
-          sparse-checkout: |
-            /.github/release/
-            /Cargo.toml
-            /docs/releases/
-          sparse-checkout-cone-mode: false
-          persist-credentials: false
-      - id: plan
-        run: SHA=$(git rev-parse HEAD) bash .github/release/plan.sh
-        env:
-          EVENT: ${{ github.event_name }}
-          REF_NAME: ${{ github.ref_name }}
-          CHANNEL: ${{ github.event_name == 'workflow_dispatch' && inputs.channel || 'dev' }}
-          GH_TOKEN: ${{ github.token }}
-
-  # ---- Build: repository code; no environment, secrets, or id-token ----------
-
-  build:
-    needs: plan
-    uses: ./.github/workflows/build-desktop.yml
-    with:
-      sha: ${{ github.sha }}
-      version: ${{ needs.plan.outputs.release-version }}
-      channel: ${{ needs.plan.outputs.release-channel }}
-
-  # ---- Full test suites: check and stable only; repository code, no secrets ---
-  # Pull requests only compile and dev pushes run no checks (CI is minimal),
-  # so the candidate's full suites run here. A stable run publishes nothing
-  # until all three pass.
-
-  check-linux:
-    needs: plan
-    if: needs.plan.outputs.channel == 'stable' || needs.plan.outputs.channel == 'check'
-    uses: ./.github/workflows/check-linux.yml
-    with:
-      sha: ${{ github.sha }}
-
-  check-macos:
-    needs: plan
-    if: needs.plan.outputs.channel == 'stable' || needs.plan.outputs.channel == 'check'
-    uses: ./.github/workflows/check-macos.yml
-    with:
-      sha: ${{ github.sha }}
-
-  check-windows:
-    needs: plan
-    if: needs.plan.outputs.channel == 'stable' || needs.plan.outputs.channel == 'check'
-    uses: ./.github/workflows/check-windows.yml
-    with:
-      sha: ${{ github.sha }}
-
-  # Onboarding gates every stable release (AGENTS.md): every onboarding scene
-  # against its approved golden, and a first run through the real tour in a
-  # clean data folder (scripts/check-onboarding.sh, Linux; the macOS and
-  # Windows scenes are fixtures of the same window, rendered here), from
-  # repository code with no secrets. Publishing waits for this job and the
-  # three suites above; its scene images go into the go/no-go given to Dax.
-  onboarding:
-    needs: plan
-    if: needs.plan.outputs.channel == 'stable' || needs.plan.outputs.channel == 'check'
-    runs-on: ubuntu-24.04
-    timeout-minutes: 90
-    permissions:
-      contents: read
-    env:
-      CARGO_PROFILE_DEV_DEBUG: "0"
-      BLA_VENDOR: OpenBLAS
-      OPENSSL_NO_VENDOR: "1"
-      CC: clang
-      CXX: clang++
-    steps:
-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
-        with:
-          ref: ${{ github.sha }}
-          persist-credentials: false
-      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable
-        with:
-          toolchain: stable
-      - name: Install native libraries
-        run: |
-          sudo apt-get update
-          sudo apt-get install -y clang cmake pkg-config python3 libasound2-dev \
-            libssl-dev libgtk-3-dev libxkbcommon-x11-dev libx11-xcb-dev \
-            libfontconfig1-dev libfreetype-dev libxcursor-dev libxi-dev \
-            libxrandr-dev libopenblas-dev libvulkan-dev glslc libshaderc-dev \
-            mesa-vulkan-drivers
-      - name: Check onboarding
-        run: |
-          status=0
-          scripts/check-onboarding.sh "$RUNNER_TEMP/onboarding" || status=$?
-          cat "$RUNNER_TEMP/onboarding/summary.md" >> "$GITHUB_STEP_SUMMARY" || true
-          exit "$status"
-      - name: Upload the scenes
-        if: always()
-        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
-        with:
-          name: onboarding-scenes
-          path: |
-            ${{ runner.temp }}/onboarding
-            /tmp/rune-settings-*-actual.png
-          if-no-files-found: ignore
-
-  # Voinc.app as the release identity (io.voinc.voinc), ad-hoc signed; sign-macos
-  # signs it with the Developer ID.
-  build-macos:
-    needs: plan
-    runs-on: macos-26
-    timeout-minutes: 120
-    env:
-      VOINC_VERSION: ${{ needs.plan.outputs.release-version }}
-      VOINC_BUILD_CHANNEL: ${{ needs.plan.outputs.release-channel }}
-    outputs:
-      digest: ${{ steps.upload.outputs.digest }}
-    steps:
-      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
-        with:
-          ref: ${{ github.sha }}
-          persist-credentials: false
-      - uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable
