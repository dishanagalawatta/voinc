+
+    #[test]
+    fn a_word_annotation_is_a_timed_word() {
+        let interaction: Interaction = serde_json::from_str(
+            r#"{"status":"completed","steps":[{"content":[
+                {"type":"text","text":"Hello",
+                 "annotations":[{"type":"word_info","text":"Hello",
