+    row()
+        .key("google-batch-only-row")
+        .gap(8.0)
+        .center_y()
+        .flex_wrap()
+        .child(
+            text(tr("Skip live streaming"))
+                .key("label")
+                .font(controls::DESCRIPTION)
+                .color(p.muted()),
+        )
+        .child(switch)
