# Maintainer: dax
#
# Not a prebuilt of extra/voinc (the voinc dump tool, which installs /usr/bin/hx):
# this is the Voinc voice dictation app, so it neither provides nor conflicts
# with it.
#
# Generated from dishanagalawatta/voinc packaging/aur by scripts/release-aur.sh, which
# sets pkgver, the release service's linux-x64 and linux-arm64 file URLs, and
# the checksums for each release.
pkgname=voinc-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Voinc voice dictation app by Anomaly: hold a key, speak, and it types (Linux beta; not the voinc dump tool)'
arch=('x86_64' 'aarch64')
url='https://github.com/dishanagalawatta/voinc'
license=('MIT')
# Linked: alsa-lib, gcc-libs, glibc, vulkan-icd-loader. Loaded at
# runtime: the X11/Wayland/xkbcommon client libraries and OpenBLAS.
depends=(
  'alsa-lib' 'curl' 'gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor'
  'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'openblas' 'vulkan-icd-loader'
  'wayland'
)
optdepends=(
  'wl-clipboard: paste on Wayland'
  'wtype: paste on Wayland'
  'vulkan-driver: GPU transcription'
  'wireplumber: mute output while dictating (or libpulse for pactl)'
  'xdg-utils: open links from voice commands'
)
options=('!strip' '!debug')
install=voinc-bin.install
source=(
  'io.voinc.voinc.desktop'
  'voinc.service'
  'LICENSE'
  'io.voinc.voinc-16.png' 'io.voinc.voinc-24.png' 'io.voinc.voinc-32.png' 'io.voinc.voinc-48.png'
  'io.voinc.voinc-64.png' 'io.voinc.voinc-128.png' 'io.voinc.voinc-256.png' 'io.voinc.voinc-512.png'
)
source_x86_64=("voinc-${pkgver}-linux-x64::@URL_X64@")
source_aarch64=("voinc-${pkgver}-linux-arm64::@URL_ARM64@")
sha256sums=('@DESKTOP_SHA256@'
            '@SERVICE_SHA256@'
            '@LICENSE_SHA256@'
            @ICON_SHA256S@)
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local target=x64
  [ "$CARCH" = aarch64 ] && target=arm64
  install -Dm755 "voinc-${pkgver}-linux-${target}" "$pkgdir/usr/bin/voinc"
  install -Dm644 io.voinc.voinc.desktop "$pkgdir/usr/share/applications/io.voinc.voinc.desktop"
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "io.voinc.voinc-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.voinc.voinc.png"
  done
  install -Dm644 voinc.service "$pkgdir/usr/lib/systemd/user/voinc.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
